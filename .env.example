# Copy this file to .env and fill in real values. Never commit .env.
#
# DOMAIN must point at the server's public IP before Caddy can issue HTTPS.
# A free DuckDNS subdomain works well, for example:
#   carebydent.duckdns.org
DOMAIN=carebydent.example.com

POSTGRES_DB=dentcare
POSTGRES_USER=dentcare
# Use only letters and numbers here (for example: openssl rand -hex 24).
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The Oracle VM has plenty of memory; 512 MB of Java heap is comfortable.
JAVA_OPTS="-Xmx512m -XX:+UseSerialGC -Djava.awt.headless=true"

# Password-reset and contact emails. Copy the same SMTP values that already
# work on Render. Leave MAIL_USERNAME empty to only log emails (not recommended
# in production, because nobody receives the reset link).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
