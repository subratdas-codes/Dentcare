# Copy this file to .env and fill in real values. Never commit .env.
#
# DOMAIN must point at the server's public IP before Caddy can issue HTTPS.
# A free DuckDNS subdomain works well, for example:
#   carebydent.duckdns.org
DOMAIN=carebydent.example.com

POSTGRES_DB=dentcare
POSTGRES_USER=dentcare
POSTGRES_PASSWORD=replace-with-a-long-random-password
